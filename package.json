{
  "name": "skul-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "seed:products": "node scripts/seed-products.mjs",
    "test": "npm run test:web && npm run test:worker",
    "test:web": "vitest run",
    "test:worker": "vitest run --config vitest.worker.config.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && vitest run --config vitest.worker.config.js --coverage",
    "test:all": "npm run test:rules && npm run test && npm run build",
    "test:rules": "firebase emulators:exec --only firestore \"node scripts/test-rules.mjs\""
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^25.0.1",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
